.poi {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
}

.head {
  display: flex;
  align-items: flex-start;
}

.time-col {
  flex: 0 0 108rpx;
  display: flex;
  flex-direction: column;
}

.time {
  font-size: 30rpx;
  font-weight: 600;
  color: #2563eb;
  line-height: 44rpx;
}

.dur {
  font-size: 22rpx;
  color: #9aa1a9;
  line-height: 34rpx;
}

.main {
  flex: 1;
  padding-right: 16rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.tag {
  padding: 0 10rpx;
  margin-right: 12rpx;
  border-radius: 6rpx;
  background-color: #f1f3f5;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 32rpx;
}

.sub-text {
  flex: 1;
  font-size: 24rpx;
  color: #9aa1a9;
  line-height: 32rpx;
  word-break: break-all;
}

.edit {
  flex: 0 0 auto;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
  color: #2563eb;
  line-height: 36rpx;
}

.facts {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #f1f3f5;
}

.facts-head {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.facts-title {
  flex: 1;
  font-size: 24rpx;
  color: #9aa1a9;
}

.note {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f1f3f5;
}

.act {
  margin-left: 16rpx;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  background-color: #f1f3f5;
  color: #374151;
  font-size: 24rpx;
}

.act.is-danger {
  background-color: #fef2f2;
  color: #b91c1c;
}
