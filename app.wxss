page {
  background-color: #f4f7fc;
  color: #1f2937;
  font-size: 30rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
}

.page {
  box-sizing: border-box;
  padding: 24rpx 24rpx 56rpx;
}

.page-tab {
  box-sizing: border-box;
  padding: 24rpx 24rpx 48rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(37, 99, 235, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.muted {
  color: #64748b;
  font-size: 26rpx;
}

.tiny {
  color: #94a3b8;
  font-size: 24rpx;
}

.center {
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.divider {
  height: 2rpx;
  background-color: #edf1f7;
  margin: 20rpx 0;
}

/* 底部操作区改为随页面滚动，避免切换页面时悬浮按钮残留在新页面上 */
.footer-bar {
  margin-top: 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.btn-primary {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: linear-gradient(135deg, #2563eb 0%, #4f8bf9 100%);
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.22);
}

.btn-primary.is-disabled {
  background: #c3ccda;
  box-shadow: none;
}

.btn-ghost {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background-color: #ffffff;
  color: #2563eb;
  border: 2rpx solid #bfdbfe;
  border-radius: 20rpx;
  font-size: 32rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 26rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 38rpx;
  background-color: #eef2f8;
  color: #475569;
  font-size: 28rpx;
}

.chip.is-active {
  background-color: #e8f0fe;
  color: #2563eb;
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx #2563eb;
}

.ph {
  color: #b7c0cd;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.field-box {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 24rpx;
  background-color: #f5f7fb;
  border-radius: 16rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.field-box.is-focus {
  background-color: #ffffff;
  box-shadow: inset 0 0 0 2rpx #2563eb;
}

.field-input {
  flex: 1;
  height: 92rpx;
  font-size: 30rpx;
}

.field-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.field-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  background-color: #f5f7fb;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 主列表卡片：整块可点，所以圆角与内边距都放在外层 */
.list-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(37, 99, 235, 0.06);
}

.list-card:active {
  background-color: #f8faff;
}

.list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 32rpx;
}

.badge-pending {
  color: #b45309;
  background-color: #fef3c7;
}

.badge-done {
  color: #1d4ed8;
  background-color: #dbeafe;
}

.badge-neutral {
  color: #64748b;
  background-color: #eef2f8;
}

.empty {
  padding: 140rpx 48rpx 60rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.6;
}

.empty-action {
  display: inline-block;
  margin-top: 36rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 48rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #2563eb 0%, #4f8bf9 100%);
  color: #ffffff;
  font-size: 28rpx;
  box-shadow: 0 10rpx 22rpx rgba(37, 99, 235, 0.22);
}

.btn-sm {
  display: inline-block;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 26rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background-color: #eef2f8;
  color: #475569;
  text-align: center;
}

.btn-sm.is-primary {
  background-color: #2563eb;
  color: #ffffff;
}

.text-danger {
  color: #dc2626;
}
