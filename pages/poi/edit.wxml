<view class="edit-page">
  <!-- 位置：选点与清除合成一个区域，城市只做参考，不再占表单项 -->
  <view class="c-card">
    <view class="c-title">位置</view>

    <view class="city-hint" wx:if="{{!located}}" bindtap="onOpenCity">
      定位参考：{{cityHint}}<text class="hint-action">点击更改</text>
    </view>

    <view class="loc-card" wx:if="{{located}}">
      <view class="loc-main">
        <view class="loc-name">{{form.name || '已选位置'}}</view>
        <view class="loc-addr">{{form.address || coordText}}</view>
      </view>
      <view class="loc-actions">
        <view class="loc-edit" bindtap="onChooseLocation">修改位置</view>
        <view class="loc-del" bindtap="onClearLocation">🗑</view>
      </view>
    </view>
    <view class="pick-btn" wx:else bindtap="onChooseLocation">📍 在地图上选择位置</view>

    <view class="c-field" wx:if="{{!located || !form.name}}">
      <view class="c-label">地点名称</view>
      <input
        class="ipt"
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
        placeholder="{{located ? '地图没返回名称，手动填一个' : '例如 西湖断桥'}}"
        placeholder-class="ph"
        maxlength="30"
      />
    </view>

    <view class="c-field" wx:if="{{!located}}">
      <view class="c-label">地址<text class="c-optional">选填</text></view>
      <input
        class="ipt"
        value="{{form.address}}"
        data-field="address"
        bindinput="onInput"
        placeholder="可以手填，也可以在上面选点"
        placeholder-class="ph"
        maxlength="60"
      />
    </view>

    <view class="c-tip" wx:if="{{!located}}">不选点也能保存，只是地图页上看不到这个地点。</view>
  </view>

  <!-- 分类与停留：3 列网格，6 个分类正好两排 -->
  <view class="c-card">
    <view class="c-title">分类</view>
    <view class="grid">
      <view
        class="g-item {{form.category === item ? 'is-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-key="{{item}}"
        bindtap="onCategory"
      >{{item}}</view>
    </view>

    <view class="c-title is-sub">停留时长</view>
    <view class="grid">
      <view
        class="g-item {{form.durationMin === item ? 'is-active' : ''}}"
        wx:for="{{durations}}"
        wx:key="*this"
        data-key="{{item}}"
        bindtap="onDuration"
      >{{item}} 分钟</view>
    </view>

    <view class="form-row">
      <text class="row-label">预计到达</text>
      <picker mode="time" value="{{form.plannedTime}}" bindchange="onTime">
        <view class="time-val {{form.plannedTime ? '' : 'is-empty'}}">{{form.plannedTime || '选择时间'}}</view>
      </picker>
    </view>
    <view class="c-tip">不填则排在当天最后。</view>
  </view>

  <!-- 已知信息：标准表单行，右对齐输入 -->
  <view class="c-card">
    <view class="facts-head">
      <view class="c-title is-inline">已知信息<text class="c-optional">选填</text></view>
      <view class="state-tag {{form.factsPending ? 'is-pending' : 'is-done'}}">
        {{form.factsPending ? '待核实' : '已核实'}}
      </view>
    </view>

    <view class="fact-row">
      <text class="fact-label">营业时间</text>
      <input
        class="fact-input"
        value="{{form.facts.open}}"
        data-key="open"
        bindinput="onFactInput"
        placeholder="例如 08:00-17:30"
        placeholder-class="ph"
        maxlength="40"
      />
    </view>
    <view class="fact-row">
      <text class="fact-label">预约</text>
      <input
        class="fact-input"
        value="{{form.facts.reserve}}"
        data-key="reserve"
        bindinput="onFactInput"
        placeholder="例如 需提前 1 天预约"
        placeholder-class="ph"
        maxlength="40"
      />
    </view>
    <view class="fact-row is-last">
      <text class="fact-label">费用</text>
      <input
        class="fact-input"
        value="{{form.facts.fee}}"
        data-key="fee"
        bindinput="onFactInput"
        placeholder="例如 门票 40 元"
        placeholder-class="ph"
        maxlength="40"
      />
    </view>

    <view class="switch-row">
      <view class="switch-copy">
        <view class="switch-label">这些信息还没核实</view>
        <view class="switch-desc">现场确认后再关掉，扫一眼就知道哪些要核对</view>
      </view>
      <switch checked="{{form.factsPending}}" color="#2563eb" bindchange="onPending" />
    </view>
  </view>

  <!-- 备注 -->
  <view class="c-card">
    <view class="c-title">备注</view>
    <textarea
      class="note-box"
      value="{{form.note}}"
      data-field="note"
      bindinput="onInput"
      placeholder="要带什么、跟谁去、入口在哪一层……"
      placeholder-class="ph"
      maxlength="200"
    />
  </view>

  <view class="danger-zone" wx:if="{{poiId}}">
    <view class="danger-link" bindtap="onRemove">删除这个地点</view>
  </view>

  <view class="save-bar">
    <view class="save-btn {{saving ? 'is-disabled' : ''}}" bindtap="onSave">
      {{saving ? '保存中…' : '保存'}}
    </view>
  </view>

  <!-- 城市选择弹层：只影响选点地图从哪开始 -->
  <view class="sheet-mask" wx:if="{{showCity}}" bindtap="onCloseCity"></view>
  <view class="sheet" wx:if="{{showCity}}">
    <view class="sheet-head">
      <text class="sheet-title">选点从哪开始</text>
      <text class="sheet-close" bindtap="onCloseCity">关闭</text>
    </view>
    <input
      class="sheet-input"
      value="{{cityQuery}}"
      bindinput="onCityInput"
      placeholder="搜索城市或省份，如 杭州、云南"
      placeholder-class="ph"
      maxlength="20"
    />
    <scroll-view class="city-list" scroll-y wx:if="{{cityOptions.length}}">
      <view
        class="city-item"
        wx:for="{{cityOptions}}"
        wx:key="name"
        data-name="{{item.name}}"
        bindtap="onPickCity"
      >
        <text class="city-name">{{item.name}}</text>
        <text class="city-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
      </view>
    </scroll-view>
    <view class="sheet-tip" wx:else>输入城市名，选点地图会先落到那里</view>
  </view>
</view>
