<view class="profile-page">
  <!-- 头部个人信息 -->
  <view class="p-card head-card" bindtap="onHeadTap">
    <image
      wx:if="{{userInfo && userInfo.avatar}}"
      class="avatar"
      src="{{userInfo.avatar}}"
      mode="aspectFill"
    />
    <view wx:else class="avatar avatar-guest">👤</view>

    <view class="head-info">
      <view class="head-name">{{userInfo && userInfo.nickname ? userInfo.nickname : '未登录用户'}}</view>
      <view class="head-id">{{idText}}</view>
    </view>

    <view class="head-chev">›</view>
  </view>

  <!-- 数据看板 -->
  <view class="p-card stats-card">
    <view class="stat">
      <view class="stat-value">{{cityCount}}</view>
      <view class="stat-label">去过城市</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat">
      <view class="stat-value">{{tripCount}}</view>
      <view class="stat-label">总行程</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat">
      <view class="stat-value">{{totalText}}</view>
      <view class="stat-label">总花费</view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="p-card menu-card">
    <view class="menu-item" bindtap="onInvite">
      <view class="menu-left">
        <view class="menu-icon icon-blue">👥</view>
        <text class="menu-text">同行邀请</text>
      </view>
      <text class="menu-chev">›</text>
    </view>

    <view class="menu-item" bindtap="onPrivacy">
      <view class="menu-left">
        <view class="menu-icon icon-purple">🔒</view>
        <text class="menu-text">隐私协议</text>
      </view>
      <text class="menu-chev">›</text>
    </view>

    <view class="menu-item" bindtap="onClearCache">
      <view class="menu-left">
        <view class="menu-icon icon-orange">🧹</view>
        <text class="menu-text">清除本地缓存</text>
      </view>
      <text class="menu-chev">›</text>
    </view>
  </view>

  <!-- 退出登录：单独白卡片，靠颜色警示 -->
  <view class="p-card logout-card" wx:if="{{userInfo}}" bindtap="onLogout">
    <text class="logout-text">退出登录</text>
  </view>
</view>
