<view class="trip-page">
  <!-- 顶部：只留标题与计数，背景直接露出来 -->
  <view class="head">
    <view class="head-title">下一站，去哪？</view>
    <view class="head-sub">已记录 {{tripCount}} 次旅行</view>
  </view>

  <view class="body">
    <view class="error-card" wx:if="{{error}}">
      <view class="error-text">{{error}}</view>
      <view class="error-retry" bindtap="onRetry">重试</view>
    </view>

    <view class="loading" wx:elif="{{loading}}">加载中…</view>

    <block wx:elif="{{trips.length}}">
      <view
        class="trip-card"
        wx:for="{{trips}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="onOpen"
      >
        <view class="card-main">
          <view class="card-tag">{{item.tag}}</view>
          <view class="card-title">{{item.title}}</view>
          <view class="card-meta">{{item.metaText}}</view>
        </view>
        <view class="card-side">
          <view class="card-poi">{{item.poiText}}</view>
          <view class="card-chev">›</view>
        </view>
      </view>
    </block>

    <!-- 空状态：垂直 + 水平居中 -->
    <view class="empty" wx:else>
      <view class="empty-icon">🎒</view>
      <view class="empty-title">还没有旅行计划</view>
      <view class="empty-desc">{{needLogin ? '登录后开启你的第一场旅行' : '选好日期和目的地，再一天一天往里加地点'}}</view>
      <view class="empty-btn" wx:if="{{needLogin}}" bindtap="onGoLogin">去登录</view>
    </view>
  </view>

  <!-- 悬浮新建按钮 -->
  <view class="fab" bindtap="onCreate">＋</view>
</view>
