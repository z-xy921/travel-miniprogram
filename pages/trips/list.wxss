page {
  background-color: #f8fafc;
}

.trip-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx 0;
  background-color: #f8fafc;
}

/* —— 顶部欢迎语 —— */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx 44rpx;
}

.head-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 1rpx;
  color: #0f172a;
}

.head-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #64748b;
}

.head-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #e8f0fe;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.16);
}

.head-avatar-guest {
  font-size: 36rpx;
  line-height: 80rpx;
  text-align: center;
  color: #94a3b8;
  background-color: #e2e8f0;
  box-shadow: none;
}

/* —— 内容区 —— */
.body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.error-card {
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.error-text {
  font-size: 28rpx;
  color: #64748b;
}

.error-retry {
  display: inline-block;
  margin-top: 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 40rpx;
  border-radius: 32rpx;
  background-color: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
}

/* —— 行程卡片 —— */
.trip-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.trip-card:active {
  background-color: #fbfdff;
}

.trip-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trip-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2328;
}

.trip-chev {
  font-size: 36rpx;
  line-height: 1;
  color: #cbd5e1;
}

.trip-tags {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  margin-right: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 32rpx;
}

.tag-plain {
  color: #2563eb;
  background-color: #eff6ff;
}

.trip-line {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #475569;
}

.trip-line-dim {
  margin-top: 6rpx;
  color: #94a3b8;
}

/* —— 空状态 —— */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx 96rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  background-color: #eff6ff;
  font-size: 120rpx;
  line-height: 1;
}

.empty-title {
  margin-top: 36rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2328;
  text-align: center;
}

.empty-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #64748b;
  text-align: center;
}

.empty-btn {
  margin-top: 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 56rpx;
  border-radius: 30rpx;
  background-color: #eff6ff;
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-btn:active {
  background-color: #dbeafe;
}

/* —— 底部主按钮 —— */
.foot {
  padding: 24rpx 0 calc(32rpx + env(safe-area-inset-bottom));
}

.btn-new {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.28);
}

.btn-new:active {
  opacity: 0.92;
}
