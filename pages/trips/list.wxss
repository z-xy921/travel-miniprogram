page {
  background-color: #f8fafc;
}

.trip-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 32rpx 32rpx calc(220rpx + env(safe-area-inset-bottom));
  background-color: #f8fafc;
}

/* —— 顶部：极简标题 —— */
.head {
  padding: 24rpx 4rpx 48rpx;
}

.head-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 1rpx;
  color: #1f2328;
}

.head-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #64748b;
}

/* —— 内容区 —— */
.body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.error-card {
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.error-text {
  font-size: 28rpx;
  color: #64748b;
}

.error-retry {
  display: inline-block;
  margin-top: 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 40rpx;
  border-radius: 32rpx;
  background-color: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
}

/* —— 行程卡片：门禁卡 / 车票感 —— */
.trip-card {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.trip-card:active {
  transform: scale(0.99);
  opacity: 0.96;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-tag {
  display: inline-block;
  max-width: 100%;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  background-color: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.6;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1f2328;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

/* 右侧虚线分隔，做出票根的分区感 */
.card-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  margin-left: 24rpx;
  padding-left: 24rpx;
  border-left: 2rpx dashed #e5eaf1;
  flex-shrink: 0;
}

.card-poi {
  font-size: 24rpx;
  color: #64748b;
}

.card-chev {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1;
  color: #cbd5e1;
}

/* —— 空状态 —— */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx 96rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  background-color: #eff6ff;
  font-size: 120rpx;
  line-height: 1;
}

.empty-title {
  margin-top: 36rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2328;
  text-align: center;
}

.empty-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #64748b;
  text-align: center;
}

.empty-btn {
  margin-top: 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 56rpx;
  border-radius: 30rpx;
  background-color: #eff6ff;
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-btn:active {
  background-color: #dbeafe;
}

/* —— 悬浮新建按钮 —— */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  font-size: 60rpx;
  line-height: 1;
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.35);
}

.fab:active {
  opacity: 0.9;
}
