page {
  background-color: #f8fafc;
}

.ledger-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background-color: #f8fafc;
}

/* —— 顶部标题 —— */
.head {
  padding: 24rpx 4rpx 44rpx;
}

.head-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 1rpx;
  color: #0f172a;
}

.head-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #64748b;
}

/* —— 内容区 —— */
.body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.error-card {
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.error-text {
  font-size: 28rpx;
  color: #64748b;
}

.error-retry {
  display: inline-block;
  margin-top: 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 40rpx;
  border-radius: 32rpx;
  background-color: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
}

/* —— 账本卡片 —— */
.bill-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.bill-card:active {
  background-color: #fbfdff;
}

.bill-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bill-title {
  flex: 1;
  margin-right: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2328;
}

.bill-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #2563eb;
}

.bill-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.bill-date {
  font-size: 26rpx;
  color: #94a3b8;
}

.bill-count {
  font-size: 26rpx;
  color: #64748b;
}

/* —— 空状态 —— */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx 96rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  background-color: #eff6ff;
  font-size: 120rpx;
  line-height: 1;
}

.empty-title {
  margin-top: 36rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2328;
  text-align: center;
}

.empty-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #64748b;
  text-align: center;
}

.empty-btn {
  margin-top: 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 56rpx;
  border-radius: 30rpx;
  background-color: #eff6ff;
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-btn:active {
  background-color: #dbeafe;
}
