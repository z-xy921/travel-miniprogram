page {
  background-color: #f8fafc;
}

.exp-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background-color: #f8fafc;
}

/* —— 通用卡片 —— */
.p-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-head {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2328;
  margin-bottom: 24rpx;
}

/* —— 顶部总览（深海蓝渐变） —— */
.hero {
  margin-bottom: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1e3a8a, #2563eb);
  box-shadow: 0 12rpx 30rpx rgba(30, 58, 138, 0.24);
  text-align: center;
}

.hero-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-total {
  margin-top: 10rpx;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #ffffff;
}

.hero-count {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.hero-cols {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.18);
}

.hero-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-col-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-col-value {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.hero-divider {
  width: 2rpx;
  height: 48rpx;
  background-color: rgba(255, 255, 255, 0.22);
}

/* —— AA 结算提示条 —— */
.debt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background-color: #fff7ed;
}

.debt-text {
  flex: 1;
  margin-right: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #c2410c;
}

.debt-btn {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background-color: #ffedd5;
  color: #c2410c;
  font-size: 24rpx;
  font-weight: 600;
}

.debt-btn:active {
  opacity: 0.85;
}

.debt.is-info {
  background-color: #eff6ff;
}

.debt.is-info .debt-text {
  color: #1d4ed8;
}

.debt.is-info .debt-btn {
  background-color: #dbeafe;
  color: #1d4ed8;
}

/* —— 分类占比 —— */
.stack {
  display: flex;
  width: 100%;
  height: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background-color: #f1f5f9;
}

.stack-seg {
  height: 100%;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.legend-item {
  box-sizing: border-box;
  width: 50%;
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx 8rpx 0;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.legend-name {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.legend-value {
  margin-left: auto;
  font-size: 24rpx;
  color: #1f2328;
}

/* —— 明细 —— */
.group {
  margin-bottom: 8rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx;
}

.group-date {
  font-size: 26rpx;
  font-weight: 600;
  color: #64748b;
}

.group-total {
  font-size: 24rpx;
  color: #94a3b8;
}

.list {
  padding: 0 32rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.row:last-child {
  border-bottom: none;
}

.row:active {
  opacity: 0.7;
}

.row-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}

.row-note {
  flex: 1;
  margin: 0 20rpx;
  font-size: 28rpx;
  color: #1f2328;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-amount {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2328;
}

/* —— 状态页 —— */
.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.error-card {
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.error-text {
  font-size: 28rpx;
  color: #64748b;
}

.error-retry {
  display: inline-block;
  margin-top: 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 40rpx;
  border-radius: 32rpx;
  background-color: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
}

.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 24rpx 120rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  background-color: #eff6ff;
  font-size: 120rpx;
  line-height: 1;
}

.empty-title {
  margin-top: 36rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2328;
  text-align: center;
}

.empty-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #64748b;
  text-align: center;
}

.empty-btn {
  margin-top: 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 56rpx;
  border-radius: 30rpx;
  background-color: #eff6ff;
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-btn:active {
  background-color: #dbeafe;
}

/* —— 底部记一笔 —— */
.foot {
  margin-top: 16rpx;
}

.btn-add {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.28);
}

.btn-add:active {
  opacity: 0.92;
}
