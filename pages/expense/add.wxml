<view class="page">
  <view class="card">
    <view class="amount-label">金额{{tripTitle ? '（' + tripTitle + '）' : ''}}</view>
    <view class="amount-show">{{amountText}}</view>
    <view class="field-box">
      <input
        class="amount-input"
        type="digit"
        value="{{amount}}"
        bindinput="onAmount"
        placeholder="输入金额"
        placeholder-class="ph"
        focus="{{true}}"
      />
      <text class="yuan">元</text>
    </view>
    <view class="quick-row">
      <view
        class="quick"
        wx:for="{{quick}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="onQuick"
      >{{item}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{payerLabels.length}}">
    <view class="between">
      <text class="field-label" style="margin-bottom: 0;">谁付的钱</text>
      <picker range="{{payerLabels}}" value="{{payerIndex}}" bindchange="onPayer">
        <view class="date-box">{{payerLabels[payerIndex]}}</view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="field-label">类别</view>
    <view class="chips">
      <view
        class="chip {{category === item ? 'is-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-key="{{item}}"
        bindtap="onCategory"
      >{{item}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{splits.length}}">
    <view class="between">
      <text class="field-label" style="margin-bottom: 0;">分摊</text>
      <text class="tiny {{splitBalanced ? '' : 'split-warn'}}">{{splitStatusText}}</text>
    </view>
    <view class="split-row" wx:for="{{splits}}" wx:key="openid">
      <view
        class="split-check {{item.checked ? 'is-on' : ''}}"
        data-index="{{index}}"
        bindtap="onToggleSplit"
      >{{item.checked ? '✓' : ''}}</view>
      <text class="split-name">{{item.label}}</text>
      <input
        class="split-input"
        type="digit"
        value="{{item.amountText}}"
        data-index="{{index}}"
        bindinput="onSplitAmount"
        disabled="{{!item.checked}}"
      />
      <text class="tiny">元</text>
    </view>
    <view class="field-tip">按勾选的人数平均分摊，金额也可以手动改。</view>
  </view>

  <view class="card">
    <view class="between">
      <text class="field-label" style="margin-bottom: 0;">日期</text>
      <picker mode="date" value="{{spentAt}}" bindchange="onDate">
        <view class="date-box">{{spentAt}}</view>
      </picker>
    </view>
    <view class="divider"></view>
    <view class="field-label">备注</view>
    <view class="field-box">
      <input
        class="field-input"
        value="{{note}}"
        bindinput="onNote"
        placeholder="例如 双人午餐"
        placeholder-class="ph"
        maxlength="100"
      />
    </view>
  </view>

  <view class="footer-bar">
    <view class="btn-primary {{saving ? 'is-disabled' : ''}}" bindtap="onSave">
      {{saving ? '保存中…' : (expenseId ? '保存修改' : '保存这一笔')}}
    </view>
  </view>
</view>
