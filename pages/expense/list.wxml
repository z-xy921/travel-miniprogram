<view class="exp-page">
  <view class="error-card" wx:if="{{error}}">
    <view class="error-text">{{error}}</view>
    <view class="error-retry" bindtap="onRetry">重试</view>
  </view>

  <!-- 游客：隐私页遮罩 -->
  <view class="empty" wx:elif="{{needLogin}}">
    <view class="empty-icon">🧾</view>
    <view class="empty-title">记账是私有的</view>
    <view class="empty-desc">登录后查看专属账单与 AA 分账</view>
    <view class="empty-btn" bindtap="onGoLogin">去登录</view>
  </view>

  <view class="loading" wx:elif="{{loading}}">加载中…</view>

  <block wx:else>
    <!-- 顶部总览 -->
    <view class="hero">
      <view class="hero-label">总支出</view>
      <view class="hero-total">{{summary.totalText}}</view>
      <view class="hero-count">共 {{summary.countText}}</view>
      <view class="hero-cols">
        <view class="hero-col">
          <view class="hero-col-label">我的垫付</view>
          <view class="hero-col-value">{{summary.paidText}}</view>
        </view>
        <view class="hero-divider"></view>
        <view class="hero-col">
          <view class="hero-col-label">我需承担</view>
          <view class="hero-col-value">{{summary.owedText}}</view>
        </view>
      </view>
    </view>

    <!-- AA 结算提示 -->
    <view class="debt {{debt.tone === 'info' ? 'is-info' : ''}}" wx:if="{{debt}}">
      <view class="debt-text">{{debt.text}}</view>
      <view class="debt-btn" bindtap="onCopySettle">生成结算单</view>
    </view>

    <!-- 分类占比 -->
    <view class="p-card" wx:if="{{summary.legend.length}}">
      <view class="card-head">分类占比</view>
      <view class="stack">
        <view
          class="stack-seg"
          wx:for="{{summary.bars}}"
          wx:key="category"
          style="width: {{item.width}}%; background-color: {{item.color}};"
        ></view>
      </view>
      <view class="legend">
        <view class="legend-item" wx:for="{{summary.legend}}" wx:key="category">
          <view class="legend-dot" style="background-color: {{item.color}};"></view>
          <text class="legend-name">{{item.category}}</text>
          <text class="legend-value">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 明细：按日期分组 -->
    <view class="group" wx:for="{{groups}}" wx:key="date">
      <view class="group-head">
        <text class="group-date">{{item.dateText}}</text>
        <text class="group-total">{{item.totalText}}</text>
      </view>
      <view class="p-card list">
        <view
          class="row"
          wx:for="{{item.items}}"
          wx:for-item="expense"
          wx:key="_id"
          data-id="{{expense._id}}"
          bindtap="onEdit"
          bindlongpress="onRemove"
        >
          <view class="row-icon" style="background-color: {{expense.tint}};">{{expense.icon}}</view>
          <text class="row-note">{{expense.note}}</text>
          <text class="row-amount">{{expense.amountText}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!groups.length}}">
      <view class="empty-icon">🧾</view>
      <view class="empty-title">还没有记录</view>
      <view class="empty-desc">记一笔，AA 结算会自动算好</view>
      <view class="empty-btn" bindtap="onAdd">记一笔</view>
    </view>

    <view class="foot" wx:if="{{groups.length}}">
      <view class="btn-add" bindtap="onAdd">记一笔</view>
    </view>
  </block>
</view>
