page {
  background-color: #f5f6f8;
}

.profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background-color: #f5f6f8;
}

/* 统一白卡片 */
.p-card {
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* —— 头部 —— */
.head-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
}

.head-card:active {
  background-color: #fcfdfe;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #eef2f7;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

.avatar-img {
  display: block;
}

/* 灰色剪影：细内圈让它显得精致 */
.avatar-guest {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  line-height: 1;
  color: #94a3b8;
  box-shadow: inset 0 0 0 2rpx #e5eaf1;
}

.head-info {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.head-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2328;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.head-link {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #2563eb;
}

.head-link.is-muted {
  color: #94a3b8;
}

.head-chev {
  margin-left: 16rpx;
  font-size: 36rpx;
  line-height: 1;
  color: #cbd5e1;
}

/* —— 数据统计 —— */
.stats-card {
  display: flex;
  align-items: center;
  padding: 36rpx 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #1f2328;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.stat-divider {
  width: 2rpx;
  height: 40rpx;
  background-color: #eef1f5;
  flex-shrink: 0;
}

/* —— 功能列表 —— */
.menu-card {
  padding: 0 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  margin-right: 16rpx;
  font-size: 32rpx;
  line-height: 1;
}

.menu-text {
  font-size: 28rpx;
  color: #1f2328;
}

.menu-text.is-danger {
  color: #dc2626;
}

.menu-chev {
  font-size: 32rpx;
  line-height: 1;
  color: #cbd5e1;
}
