<view class="detail-page">
  <view class="err-card" wx:if="{{error}}">
    <view class="err-text">{{error}}</view>
    <view class="err-btn" bindtap="onRetry">重试</view>
  </view>

  <block wx:elif="{{trip}}">
    <!-- 头部：标题 + 一行元信息 + 轻量标签，低频操作收进右上角 -->
    <view class="head">
      <view class="head-row">
        <view class="tags">
          <text class="tag {{statusClass}}">{{statusText}}</text>
          <text class="tag {{budgetText ? 'is-budget' : 'is-muted'}}">{{budgetText ? budgetText : '未填预算'}}</text>
          <text class="tag is-muted" wx:if="{{readonly}}">只读预览</text>
        </view>

        <view class="head-tools" wx:if="{{!readonly}}">
          <view class="icon-btn" bindtap="onOpenJournal">📖</view>
          <view class="icon-btn is-more" bindtap="onOpenMore">⋯</view>
        </view>
      </view>

      <view class="head-title">{{trip.title}}</view>
      <view class="head-meta">{{headMeta}}</view>

      <view class="more-mask" wx:if="{{showMore}}" bindtap="onCloseMore"></view>
      <view class="more-panel" wx:if="{{showMore}}">
        <view class="more-item" data-act="editTrip" bindtap="onMenu">编辑行程</view>
        <view class="more-item" data-act="addDay" bindtap="onMenu">加一天</view>
        <view class="more-item {{canRemoveLastDay ? '' : 'is-disabled'}}" data-act="removeDay" bindtap="onMenu">减一天</view>
        <view class="more-line"></view>
        <view class="more-item" data-act="invite" bindtap="onMenu">邀请同行</view>
        <view class="more-item" data-act="remind" bindtap="onMenu">出发提醒</view>
        <view class="more-item" data-act="copy" bindtap="onMenu">复制这趟</view>
        <view class="more-line"></view>
        <view class="more-item is-danger" data-act="status" bindtap="onMenu">{{statusAction}}</view>
      </view>
    </view>

    <view class="day-block">
      <day-tabs tabs="{{tabs}}" active="{{activeDay}}" bind:change="onDayChange" />

      <view class="day-head">
        <text class="day-count">{{dayPois.length}} 个地点</text>
        <text class="day-link" wx:if="{{dayPois.length > 1 && !readonly}}" bindtap="onReschedule">重排时间</text>
      </view>

      <poi-card
        wx:for="{{dayPois}}"
        wx:key="_id"
        item="{{item}}"
        editing="{{editing}}"
        bind:edit="onEditPoi"
        bind:togglefacts="onToggleFacts"
        bind:up="onUp"
        bind:down="onDown"
        bind:remove="onRemovePoi"
      />

      <view class="day-empty" wx:if="{{!dayPois.length}}">
        <view class="empty-emoji">🧭</view>
        <view class="empty-title">这一天还是空的</view>
        <view class="empty-desc">点下面的「+ 加地点」，把想去的地方排进来。</view>
      </view>

      <view class="tip" wx:if="{{dayPois.length}}">先看地图再调顺序，能少走回头路。</view>
    </view>

    <!-- 危险操作放最后并弱化，避免误触 -->
    <view class="danger-zone" wx:if="{{isOwner}}">
      <view class="danger-link" bindtap="onRemoveTrip">删除这趟行程</view>
    </view>
  </block>

  <view class="loading" wx:else>
    <view class="loading-text">加载中…</view>
  </view>

  <!-- 底部常驻：地图 / 排序 / 加地点 -->
  <view class="bottom-bar" wx:if="{{trip}}">
    <view class="bar-btn" bindtap="onOpenMap">
      <text class="bar-emoji">🗺️</text>
      <text class="bar-label">地图</text>
    </view>
    <view class="bar-btn {{editing ? 'is-on' : ''}}" wx:if="{{!readonly}}" bindtap="onToggleEdit">
      <text class="bar-emoji">⇅</text>
      <text class="bar-label">{{editing ? '完成' : '排序'}}</text>
    </view>
    <view class="bar-main" bindtap="onAdd">+ 加地点</view>
  </view>
</view>
