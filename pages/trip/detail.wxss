.day-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.day-actions .btn-sm {
  margin-right: 14rpx;
  margin-bottom: 6rpx;
}

.del {
  margin: 8rpx 0 40rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #dc2626;
}

.day-head {
  padding: 8rpx 8rpx 14rpx;
}

.day-count {
  font-size: 26rpx;
  color: #64748b;
}

.day-link {
  font-size: 26rpx;
  color: #2563eb;
  padding: 4rpx 0;
}

.tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 详情页工具区：手帐 / 提醒 / 复制，一行三个 */
.tools {
  display: flex;
  padding: 18rpx 8rpx;
}

.tool {
  flex: 1;
  padding: 14rpx 20rpx;
  text-align: center;
  border-right: 2rpx solid #edf1f7;
}

.tool:last-child {
  border-right: none;
}

.tool:active {
  opacity: 0.7;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2563eb;
}

.tool-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
